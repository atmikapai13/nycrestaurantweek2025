{
  "name": "nyc-restaurant-week-2025",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://nyceats.live",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && cp CNAME dist/",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "vercel-dev": "vercel dev",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --nojekyll --no-history",
    "embeddings:generate": "node scripts/generate-embeddings.js",
    "embeddings:upload": "node scripts/upload-to-pinecone.js",
    "embeddings:setup": "npm run embeddings:generate && npm run embeddings:upload"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@pinecone-database/pinecone": "^3.0.3",
    "@turf/turf": "^7.3.0",
    "@types/mapbox-gl": "^3.4.1",
    "mapbox-gl": "^3.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "redis": "^4.7.0",
    "@langchain/core": "^0.3.0",
    "@langchain/google-genai": "^0.1.0",
    "@langchain/langgraph": "^0.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "gh-pages": "^6.3.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}