{
  "redirects": [
    { "source": "/", "destination": "/spring2026/", "permanent": false },
    { "source": "/summer2025", "destination": "/summer2025/", "permanent": false },
    { "source": "/spring2026", "destination": "/spring2026/", "permanent": false }
  ],
  "rewrites": [
